{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/demo/",
      "permanent": false
    },
    {
      "source": "/brand-guide",
      "destination": "/design-system/",
      "permanent": true
    },
    {
      "source": "/brand-guide/",
      "destination": "/design-system/",
      "permanent": true
    },
    {
      "source": "/design-system/catalog/:path*",
      "destination": "/demo/design-system/catalog/:path*",
      "permanent": true
    },
    {
      "source": "/:seg(donate|monthly|my|admin|auth|about|campaigns|organizations|search|stories|support)/:path*",
      "destination": "/demo/:seg/:path*",
      "permanent": true
    },
    {
      "source": "/assets/:path*",
      "destination": "/demo/assets/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/demo/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
